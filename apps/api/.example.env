# BUNS server config
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=3000

# API
API_URL=http://192.168.122.1:3000

# Better Auth — customer portal instance. REQUIRED; must be a unique random
# string of at least 32 characters (the 'change-me-in-production' default is
# rejected at startup).
BETTER_AUTH_SECRET=
BETTER_AUTH_ALLOWED_HOSTS=

# --- Dual BetterAuth: admin console instance ---
# REQUIRED dedicated secret for the admin instance (/api/admin/auth). Must be
# independent from BETTER_AUTH_SECRET and at least 32 characters (the
# 'change-me-in-production' default is rejected at startup).
ADMIN_BETTER_AUTH_SECRET=
# better-auth admin-plugin endpoints (/api/admin/auth/admin/*) are globally
# scoped and blocked with a 404 unless this is exactly 'true'. Keep it unset
# in production — tenant management lives in the /api/admin REST routes.
ALLOW_ADMIN_PLUGIN_ROUTES=false
# Resend HTTP API for admin 2FA-style OTP verification emails. Unset = codes
# are printed to the API server console instead (dev fallback).
RESEND_API_KEY=
RESEND_FROM=

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/radii

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:5173
ADMIN_FRONTEND_URLS=http://localhost:5174

# WireGuard peer management (server-side). When enabled, the API keeps the
# peers on WG_IFACE in sync with the database using the wg CLI (needs
# CAP_NET_ADMIN). Disabled by default so dev environments without a tunnel
# still work.
WG_MANAGE_PEERS=false
WG_IFACE=wg0
WG_SERVER_PUBLIC_KEY=
WG_ENDPOINT=
WG_USE_SUDO=false
WG_MANAGEMENT_SUBNET=10.99.0.0/16
WG_INTERFACE_IP=

HOTSPOT_PORTAL_URL=http://localhost:5175
PPPOE_PORTAL_URL=
PPPOE_EXPIRED_RATE_LIMIT=512k/512k

# MPESA ENV
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Directory that admin-supplied M-Pesa certificate paths (console Settings >
# M-Pesa > certificatePath) must resolve inside; anything else is rejected.
# Empty/unset = <api cwd>/certs. The operator-level MPESA_CERTIFICATE_PATH is
# trusted and NOT restricted by this.
MPESA_ALLOWED_CERT_DIR=

# --- Payment callback authentication ---
# REQUIRED. HMAC-SHA256 secret used to sign the ?ct= token appended to every
# callback URL handed to a payment gateway (Safaricom STK + Transaction
# Status). Must be at least 32 characters; generate with: openssl rand -hex 32
PAYMENT_CALLBACK_HMAC_SECRET=
# Optional. Comma-separated IPs / IPv4 CIDRs allowed to deliver payment
# callbacks (e.g. Safaricom's egress ranges). Empty = allowlist disabled
# (one-time startup warning). IPv6 entries/peers match by exact address only.
MPESA_CALLBACK_IP_ALLOWLIST=

# Radius Server
RADIUS_SERVER=127.0.0.1

# --- FreeRADIUS REST backend authentication ---
# REQUIRED. Shared secret authenticating the /api/radius/rest callbacks
# (rlm_rest). FreeRADIUS sends it as the `x-api-key` request header via
# control:REST-HTTP-Header — see docs/radius/rest for the module config and
# the authorize/post-auth call sites. Must be at least 32 characters;
# generate with: openssl rand -hex 32
RADIUS_REST_API_KEY=

# --- HTTP rate limiting (per IP, fixed window) ---
# Optional; the defaults shown here apply when unset. Window length shared by
# all tiers, max requests per window for the default tier (/api/admin/*,
# /api/payments/*, ...), the stricter auth tier (/api/auth/*,
# /api/admin/auth/*) and the generous portal tier (/api/hotspot/*,
# /api/ppoe/* — NATed hotspot customers share egress IPs).
# /api/radius/rest/* (shared-secret authed) and /api/nas/* (device-token
# authed) are exempt; /health is never limited.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PORTAL_MAX=120

# Radius reconsiliation timing for mikrotik routers
RADIUS_SESSION_RECONCILE_SECONDS=60
RADIUS_SESSION_STALE_SECONDS=180
RADIUS_NAS_POLL_TIMEOUT_MS=10